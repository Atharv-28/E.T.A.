<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/splash_background">

    <!-- Centered logo + app name block -->
    <LinearLayout
        android:id="@+id/center_block"
        android:orientation="vertical"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:gravity="center"
        android:padding="8dp">

        <FrameLayout
            android:layout_width="140dp"
            android:layout_height="140dp"
            android:background="@drawable/white_circle"
            android:padding="16dp">

            <ImageView
                android:id="@+id/splash_logo"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:src="@drawable/logo"
                android:contentDescription="@string/app_name"
                android:scaleType="centerInside" />

        </FrameLayout>

        <TextView
            android:id="@+id/splash_app_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="E.T.A."
            android:textColor="@android:color/white"
            android:textSize="28sp"
            android:textStyle="bold"
            android:letterSpacing="0.15"
            android:layout_marginTop="16dp" />

        <TextView
            android:id="@+id/splash_subtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Expense Track &amp; Analyse"
            android:textColor="@android:color/white"
            android:textSize="14sp"
            android:textStyle="normal"
            android:alpha="0.85"
            android:layout_marginTop="6dp" />

    </LinearLayout>

    <!-- Developer credit at bottom -->
    <TextView
        android:id="@+id/splash_developer_credit"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Developed by Atharv Tambekar"
        android:textColor="@android:color/white"
        android:textSize="13sp"
        android:alpha="0.75"
        android:layout_alignParentBottom="true"
        android:layout_centerHorizontal="true"
        android:layout_marginBottom="24dp"/>

</RelativeLayout>
